# Copy to .env and fill in. Never commit .env.
RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/video

# Where cars are counted: x1,y1,x2,y2 as fractions (0-1) of the frame. Default = horizontal line at 75% height.
LINE=0.1,0.75,0.9,0.75

# auto | cuda | mps | cpu
DEVICE=auto

# Optional: Raspberry Pi LCD. Leave LCD_HOST empty to disable.
LCD_HOST=
LCD_PORT=12345
